// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceMaterialUnit {
  PIECE
  METER
  CENTIMETER
  LITER
  MILLILITER
  KILOGRAM
  GRAM
  BOX
  PACK
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedServiceRequests ServiceRequest[]      @relation("TechnicianServiceRequests")
  serviceTaskNotes        ServiceTaskNote[]
  serviceTaskMaterials    ServiceTaskMaterial[]

  @@map("users")
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  type        CustomerType @default(INDIVIDUAL)
  phone       String?      @unique
  email       String?      @unique
  addressLine String?
  city        String?
  district    String?
  postalCode  String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  serviceRequests ServiceRequest[]

  @@index([name])
  @@index([type, isActive])
  @@map("customers")
}

model ServiceRequest {
  id           String                 @id @default(uuid())
  customerId   String
  technicianId String?
  title        String                 @db.VarChar(160)
  description  String                 @db.Text
  status       ServiceRequestStatus   @default(OPEN)
  priority     ServiceRequestPriority @default(MEDIUM)
  scheduledAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician User?                 @relation("TechnicianServiceRequests", fields: [technicianId], references: [id], onDelete: SetNull)
  notes      ServiceTaskNote[]
  materials  ServiceTaskMaterial[]

  @@index([customerId, createdAt])
  @@index([technicianId, status])
  @@index([status, priority])
  @@index([createdAt])
  @@map("service_requests")
}

model ServiceTaskNote {
  id               String   @id @default(uuid())
  serviceRequestId String
  technicianId     String
  content          String   @db.VarChar(2000)
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  technician     User           @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@map("service_task_notes")
}

model ServiceTaskMaterial {
  id               String              @id @default(uuid())
  serviceRequestId String
  technicianId     String
  name             String              @db.VarChar(120)
  quantity         Decimal             @db.Decimal(10, 2)
  unit             ServiceMaterialUnit
  createdAt        DateTime            @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  technician     User           @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@map("service_task_materials")
}
