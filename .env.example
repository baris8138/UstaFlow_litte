# PostgreSQL connection string used by Prisma CLI and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ustaflow?schema=public"

# Secret used by Auth.js to protect JWT sessions. Generate a unique value per environment.
AUTH_SECRET="CHANGE_ME_WITH_A_SECURE_RANDOM_VALUE"

# One-time credentials read only by `npm run bootstrap:admin`.
# Remove these values from the runtime environment after the admin is created.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"
